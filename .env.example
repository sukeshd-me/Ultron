# ULTRON — Environment Configuration Template
# Copy this file to .env and configure as needed.

# ==============================================================================
# 1. AI MODEL PROVIDER (Optional for Cloud AI)
# ==============================================================================
# NVIDIA AI Foundation API Key for online reasoning acceleration (Nemotron 30B)
# Get a free key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# ==============================================================================
# 2. LOCAL TOOLS & CUSTOM PATHS (Optional)
# ==============================================================================
# Custom directory for extended tools/scripts (defaults to internal toolset)
# ULTRON_TOOLS=C:\path\to\tools

# Path to Android Debug Bridge (ADB) executable if not present on system PATH
# ADB_PATH=C:\platform-tools\adb.exe

# ==============================================================================
# 3. LOCAL LLM ENDPOINTS (Optional for Local AI)
# ==============================================================================
# Ollama Endpoint: http://localhost:11434
# LM Studio Endpoint: http://localhost:1234

# ==============================================================================
# 4. GOOGLE OAUTH & UPAI BACKEND AUTHENTICATION (ULTRON V1.0.8)
# ==============================================================================
# Google Cloud Console OAuth 2.0 Client ID (Desktop Application type)
# Required for native loopback PKCE authentication.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google Cloud Console OAuth 2.0 Client Secret (Desktop Application type)
# Keep strictly in local uncommitted .env file — never commit or expose to frontend.
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# UPAI Backend Firebase Database Configuration (Backend only)
FIREBASE_PROJECT_ID=your_firebase_project_id

# UPAI Authentication Backend URL:
# ------------------------------------------------------------------------------
# Development: Used ONLY during local developer testing ('npm run dev')
UPAI_BACKEND_DEV_URL=http://127.0.0.1:8080

# Production: Google Cloud Run HTTPS service URL (REQUIRED for production builds)
# Must NOT be localhost, 127.0.0.1, or laptop IP address.
# Set this to the service URL emitted by 'gcloud run deploy upai-auth'
UPAI_BACKEND_PROD_URL=https://upai-auth-REPLACE_WITH_CLOUD_RUN_URL.a.run.app



