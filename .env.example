# ULTRON — Environment Configuration Template
# Copy this file to .env and configure as needed.

# ==============================================================================
# 1. AI MODEL PROVIDER (Optional for Cloud AI)
# ==============================================================================
# NVIDIA AI Foundation API Key for online reasoning acceleration (Nemotron 30B)
# Get a free key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# ==============================================================================
# 2. LOCAL TOOLS & CUSTOM PATHS (Optional)
# ==============================================================================
# Custom directory for extended tools/scripts (defaults to internal toolset)
# ULTRON_TOOLS=C:\path\to\tools

# Path to Android Debug Bridge (ADB) executable if not present on system PATH
# ADB_PATH=C:\platform-tools\adb.exe

# ==============================================================================
# 3. LOCAL LLM ENDPOINTS (Optional for Local AI)
# ==============================================================================
# Ollama Endpoint: http://localhost:11434
# LM Studio Endpoint: http://localhost:1234
